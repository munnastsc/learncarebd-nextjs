generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  name             String?
  email            String         @unique
  password         String?        @default("123456")
  isSubscribed     Boolean        @default(false)
  plan             String?
  subscriptionEnd  DateTime?
  chatHistory      ChatHistory[]
  progress         Progress[]
  createdAt        DateTime       @default(now())
}

model PaymentRequest {
  id            String   @id @default(cuid())
  email         String
  transactionId String   @unique
  amount        Float
  plan          String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CambridgeBook {
  id          String   @id @default(cuid())
  bookNumber  Int      
  testNumber  Int      
  module      String   
  content     Json     
  audioUrl    String?  
}

model ChatHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  bookNumber  Int
  testNumber  Int
  module      String
  score       Float?
  completedAt DateTime @default(now())
}

model CustomPost {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  type        String   // 'SERVICE', 'BOOK', 'POST'
  link        String?  // External WordPress or Custom Link
  imageUrl    String?
  price       Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MenuLink {
  id        String   @id @default(cuid())
  label     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Book {
  id            String      @id @default(cuid())
  title         String
  slug          String      @unique
  description   String      @db.Text
  imageUrl      String?
  price         Float
  originalPrice Float?
  features      String[]
  videoUrl      String?
  landingPageConfig Json?    // Array of strings for feature list
  isAvailable   Boolean     @default(true)
  orders        BookOrder[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model BookOrder {
  id            String   @id @default(cuid())
  bookId        String
  book          Book     @relation(fields: [bookId], references: [id])
  customerName  String
  phone         String
  address       String   @db.Text
  quantity      Int      @default(1)
  totalAmount   Float
  status        String   @default("PENDING") // PENDING, CONFIRMED, SHIPPED, DELIVERED, CANCELLED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}